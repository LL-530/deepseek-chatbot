# ============================================================
#  基于 DeepSeek 的本地聊天机器人 · 环境配置
#  复制本文件为 .env 后按自己机器情况修改
# ============================================================

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=deepseek_chat

# ---------- Ollama 本地大模型 ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=deepseek-r1:8b
LLM_TEMPERATURE=0.7
# 摘要压缩用的模型，默认与对话模型一致
SUMMARY_MODEL=deepseek-r1:8b
# 是否把模型的思考链（deepseek-r1 的  thinking）也推给前端
SHOW_THINKING=true

# ---------- 对话记忆策略（防 token 爆炸）----------
# 短期记忆：原样保留最近 N 轮对话
SLIDING_WINDOW_ROUNDS=10
# 滑动窗口外「溢出」的老消息攒够多少条，就触发一次摘要压缩
COMPRESS_TRIGGER=10
# 喂给摘要模型的文本上限（字符）
MAX_SUMMARY_INPUT_CHARS=6000

# ---------- 认证 ----------
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_EXPIRE_HOURS=24
